---
import InkMountains from './InkMountains.astro';
// 文章封面：水墨画——按分类配不同深浅的墨色晕染 + 远山剪影 + 分类大字。
// 纯 CSS/SVG 渲染，无图片文件，34 篇文章自动全覆盖。
interface Props {
  category: string;
  variant?: 'thumb' | 'banner';
}

const { category, variant = 'thumb' } = Astro.props;

const palettes: Record<string, { from: string; to: string; glyph: string }> = {
  '前端': { from: '#2B2823', to: '#6B6455', glyph: '前' },
  '软考': { from: '#3A3A38', to: '#7A766C', glyph: '考' },
  '代码箱': { from: '#33302B', to: '#6E6759', glyph: '码' },
  '笔记': { from: '#4A4438', to: '#8A7F68', glyph: '记' },
  '随笔': { from: '#3E3B36', to: '#7C7466', glyph: '随' },
  '旅游': { from: '#2E3330', to: '#5F6B62', glyph: '游' },
  '技术思考': { from: '#26241F', to: '#57503F', glyph: '思' },
};

const palette = palettes[category] ?? { from: '#2B2823', to: '#6B6455', glyph: category.charAt(0) };
const gradient = `linear-gradient(135deg, ${palette.from} 0%, ${palette.to} 100%)`;
---

{variant === 'banner' ? (
  <div
    class="relative overflow-hidden rounded-xl text-white"
    style={`background: ${gradient};`}
  >
    {/* 水墨画：远山 + 大字 */}
    <InkMountains variant="hero" tone="paper" class="absolute inset-x-0 bottom-0 h-28" />
    <span
      aria-hidden="true"
      class="font-serif-heading pointer-events-none absolute -right-3 -bottom-12 select-none text-[11rem] font-bold leading-none opacity-20"
    >
      {palette.glyph}
    </span>
    <span
      aria-hidden="true"
      class="font-serif-heading pointer-events-none absolute right-4 top-3 select-none text-xs font-bold tracking-[0.3em] opacity-50"
    >
      ZUO
    </span>
    <div class="relative px-6 py-10 sm:px-10 sm:py-12">
      <span class="inline-block rounded-sm bg-[var(--seal)] px-2.5 py-1 text-xs font-medium text-white">
        {category}
      </span>
    </div>
    {/* 右下角小印 */}
    <span
      aria-hidden="true"
      class="seal pointer-events-none absolute bottom-4 right-4 h-8 w-8 select-none text-sm"
    >
      左
    </span>
  </div>
) : (
  <div
    class="relative flex h-full w-full shrink-0 items-center justify-center overflow-hidden rounded-xl text-white"
    style={`background: ${gradient};`}
  >
    {/* 底部小远山 */}
    <InkMountains variant="strip" tone="paper" class="absolute inset-x-0 bottom-0 h-10" />
    <span
      aria-hidden="true"
      class="font-serif-heading pointer-events-none absolute -right-1 -bottom-4 select-none text-7xl font-bold leading-none opacity-20"
    >
      {palette.glyph}
    </span>
    <span class="font-serif-heading relative px-2 text-center text-sm font-bold leading-snug">
      {category}
    </span>
    {/* 左上角朱红印点 */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute left-2 top-2 h-2.5 w-2.5 rounded-[2px] bg-[var(--seal)] opacity-90"
    />
  </div>
)}
