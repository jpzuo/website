---
import { ArrowUpRight, Download } from '@lucide/astro';
import Github from './icons/Github.astro';

interface Props {
  slug?: string;
  title: string;
  description: string;
  type: 'commercial' | 'opensource' | 'experiment';
  techStack: string[];
  github?: string;
  demo?: string;
  download?: string;
  featured?: boolean;
}

const { slug, title, description, type, techStack, github, demo, download, featured } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const downloadUrl = download ? `${base}${download.replace(/^\//, '')}` : undefined;

const typeLabel = {
  commercial: '上线 / 商业产品',
  opensource: '开源工具',
  experiment: '实验探索',
}[type] || '开源工具';
---

<div class="group py-10 first:pt-6">
  {/* 类型与精选标记：素面小字 */}
  <div class="mb-3 flex items-center gap-3 text-xs font-mono-code text-[var(--text-muted)]">
    <span>{typeLabel}</span>
    {featured && (
      <span class="font-serif-heading font-medium text-[var(--accent)]">★ 精选</span>
    )}
  </div>

  {/* Title */}
  <h3 class="font-serif-heading text-2xl font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors tracking-tight sm:text-3xl">
    {slug ? <a href={`${base}projects/${slug}`}>{title}</a> : title}
  </h3>

  {/* Description */}
  <p class="mt-3 max-w-2xl text-base text-[var(--text-secondary)] leading-relaxed">
    {description}
  </p>

  {/* Tech stack: 素面小字，以 · 分隔 */}
  <p class="mt-4 font-mono-code text-xs text-[var(--text-muted)]">
    {techStack.join(' · ')}
  </p>

  {/* Links */}
  <div class="mt-5 flex flex-wrap items-center gap-5 text-sm font-medium">
    {slug && (
      <a
        href={`${base}projects/${slug}`}
        class="inline-flex items-center gap-1 text-[var(--accent)] hover:underline"
      >
        <span>查看完整介绍</span>
        <ArrowUpRight class="w-4 h-4" />
      </a>
    )}
    {download && (
      <a
        href={downloadUrl}
        download
        class="inline-flex items-center gap-1 text-[var(--accent)] hover:underline"
      >
        <Download class="w-4 h-4" />
        <span>下载作品包 (.zip)</span>
      </a>
    )}
    {demo && (
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-[var(--accent)] hover:underline"
      >
        <span>在线体验</span>
        <ArrowUpRight class="w-4 h-4" />
      </a>
    )}
    {github && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        <Github class="w-4 h-4" />
        <span>源码仓库</span>
      </a>
    )}
  </div>

  <span aria-hidden="true" class="brush-line mt-10"></span>
</div>
