---
// 共用水墨山峦：两层淡墨远山（纯墨色，无红日）。
// 柔和处理：山形用平滑贝塞尔曲线 + 高斯模糊，边缘化入纸面，不再是硬折线。
// variant="hero" 用于首屏（高、山更浓）；variant="strip" 用于每页底部（矮、更淡）。
// tone="paper" 用于深色墨底上的封面（山用纸色），默认 tone="ink" 用于浅色纸面。
interface Props {
  variant?: 'hero' | 'strip';
  tone?: 'ink' | 'paper';
  class?: string;
}

const { variant = 'strip', tone = 'ink', class: className = '' } = Astro.props;
const tall = variant === 'hero';
// 纸色山（深墨底上）需要更高不透明度才看得见
const farOpacity = tone === 'paper' ? (tall ? 0.16 : 0.12) : (tall ? 0.09 : 0.06);
const nearOpacity = tone === 'paper' ? (tall ? 0.28 : 0.2) : (tall ? 0.15 : 0.1);
const fill = tone === 'paper' ? 'var(--bg-page)' : 'var(--text-primary)';
---

<svg
  aria-hidden="true"
  class={`pointer-events-none w-full ${className}`}
  preserveAspectRatio="none"
  viewBox="0 0 800 120"
>
  <defs>
    <filter id="ink-mountains-soft" x="-5%" y="-20%" width="110%" height="140%">
      <feGaussianBlur stdDeviation="2.5" />
    </filter>
  </defs>
  <path
    d="M0 90 C60 55, 120 80, 180 50 C240 25, 300 75, 360 55 C420 35, 480 80, 540 58 C600 38, 660 78, 720 55 C760 42, 780 55, 800 50 L800 120 L0 120 Z"
    fill={fill}
    opacity={farOpacity}
    filter="url(#ink-mountains-soft)"
  />
  <path
    d="M0 105 C80 75, 160 98, 240 72 C320 50, 400 95, 480 75 C560 55, 640 95, 720 72 C760 62, 780 72, 800 68 L800 120 L0 120 Z"
    fill={fill}
    opacity={nearOpacity}
    filter="url(#ink-mountains-soft)"
  />
</svg>
