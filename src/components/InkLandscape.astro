---
// 湖山水墨：喀斯特峰林 + 云雾 + 湖面倒影 + 小船 + 水榭 + 飞鸟。
// 按参考图（雾中山水、湖心小船）重绘，纯墨色，无红日。
// 构图取 slice 安全带：关键元素集中在 x 350–850、y 140–280，
// 宽屏裁剪与窄屏居中裁剪下都能完整呈现。
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  aria-hidden="true"
  class={`pointer-events-none w-full ${className}`}
  preserveAspectRatio="xMidYMid slice"
  viewBox="0 0 1200 420"
>
  <defs>
    <linearGradient id="ink-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--bg-page)" stop-opacity="0" />
      <stop offset="50%" stop-color="var(--bg-page)" stop-opacity="0.55" />
      <stop offset="100%" stop-color="var(--bg-page)" stop-opacity="0" />
    </linearGradient>
  </defs>
  {/* 远山：淡墨峰林 */}
  <path
    d="M0 260 L70 200 L120 245 L180 165 L240 240 L300 175 L360 250 L430 160 L500 240 L560 180 L640 250 L720 155 L800 235 L870 170 L940 245 L1010 160 L1080 240 L1150 185 L1200 230 L1200 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.07"
  />
  {/* 云雾 */}
  <rect x="0" y="205" width="1200" height="70" fill="url(#ink-mist)" />
  {/* 中山：较浓的峰林，两座高耸的石峰 */}
  <path
    d="M0 285 L110 215 L190 275 L290 165 L380 270 L470 200 L560 280 L660 170 L750 275 L850 195 L950 280 L1050 175 L1140 265 L1200 220 L1200 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.13"
  />
  {/* 云雾 */}
  <rect x="0" y="250" width="1200" height="60" fill="url(#ink-mist)" />
  {/* 近岸：左右两团深色山脚 */}
  <path
    d="M0 305 L120 272 L240 296 L310 282 L310 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.2"
  />
  <path
    d="M890 288 L1020 268 L1140 292 L1200 278 L1200 420 L890 420 Z"
    fill="var(--text-primary)"
    opacity="0.2"
  />
  {/* 湖面 */}
  <rect x="0" y="285" width="1200" height="35" fill="var(--text-primary)" opacity="0.05" />
  {/* 湖面倒影：横向淡痕 */}
  <ellipse cx="450" cy="296" rx="90" ry="4" fill="var(--text-primary)" opacity="0.06" />
  <ellipse cx="720" cy="301" rx="120" ry="5" fill="var(--text-primary)" opacity="0.06" />
  <ellipse cx="960" cy="293" rx="80" ry="4" fill="var(--text-primary)" opacity="0.06" />
  {/* 水榭（左岸小亭） */}
  <g stroke="var(--text-primary)" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.55">
    <path d="M312 262 L330 250 L348 262" />
    <path d="M318 262 L318 272 M330 260 L330 272 M342 262 L342 272" />
  </g>
  {/* 湖心小船：船身 + 舱亭 + 倒影 */}
  <g fill="var(--text-primary)" opacity="0.75">
    <path d="M570 268 Q600 278 630 268 L626 262 L574 262 Z" />
    <rect x="588" y="250" width="24" height="12" />
    <path d="M584 251 Q600 238 616 251 Z" />
  </g>
  <path d="M576 282 Q600 290 624 282" stroke="var(--text-primary)" stroke-width="2" fill="none" opacity="0.12" />
  {/* 飞鸟 */}
  <path
    d="M400 158 q7 -7 14 0 q7 -7 14 0"
    stroke="var(--text-primary)"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    opacity="0.5"
  />
  <path
    d="M780 148 q6 -6 12 0 q6 -6 12 0"
    stroke="var(--text-primary)"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    opacity="0.4"
  />
</svg>
