---
// 湖山水墨：喀斯特峰林 + 云雾 + 湖面倒影 + 小船 + 水榭 + 飞鸟。
// 按参考图（雾中山水、湖心小船）重绘，纯墨色，无红日。
// 柔和处理：山体用平滑贝塞尔曲线 + 高斯模糊，边缘化入雾中，不再是硬折线多边形；
// 小船、水榭、飞鸟保持清晰。构图取 slice 安全带：关键元素集中在
// x 350–850、y 140–280，宽屏裁剪与窄屏居中裁剪下都能完整呈现。
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  aria-hidden="true"
  class={`pointer-events-none w-full ${className}`}
  preserveAspectRatio="xMidYMid slice"
  viewBox="0 0 1200 420"
>
  <defs>
    <linearGradient id="ink-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--bg-page)" stop-opacity="0" />
      <stop offset="50%" stop-color="var(--bg-page)" stop-opacity="0.55" />
      <stop offset="100%" stop-color="var(--bg-page)" stop-opacity="0" />
    </linearGradient>
    <filter id="ink-blur-far" x="-5%" y="-20%" width="110%" height="140%">
      <feGaussianBlur stdDeviation="10" />
    </filter>
    <filter id="ink-blur-mid" x="-5%" y="-20%" width="110%" height="140%">
      <feGaussianBlur stdDeviation="6" />
    </filter>
    <filter id="ink-blur-near" x="-5%" y="-20%" width="110%" height="140%">
      <feGaussianBlur stdDeviation="3" />
    </filter>
  </defs>
  {/* 远山：淡墨峰林，平滑曲线 + 强模糊 */}
  <path
    d="M0 270 C60 220, 120 250, 180 200 C240 160, 300 230, 360 190 C420 155, 480 230, 540 195 C600 165, 660 235, 720 190 C780 155, 840 225, 900 190 C960 160, 1020 230, 1080 195 C1140 165, 1180 220, 1200 205 L1200 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.08"
    filter="url(#ink-blur-far)"
  />
  {/* 云雾 */}
  <rect x="0" y="205" width="1200" height="70" fill="url(#ink-mist)" />
  {/* 中山：较浓的峰林，平滑曲线 + 中度模糊 */}
  <path
    d="M0 290 C80 235, 150 275, 220 210 C290 155, 360 260, 430 205 C500 160, 570 265, 640 200 C710 150, 780 260, 850 205 C920 160, 990 265, 1060 210 C1130 165, 1180 240, 1200 225 L1200 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.14"
    filter="url(#ink-blur-mid)"
  />
  {/* 云雾 */}
  <rect x="0" y="250" width="1200" height="60" fill="url(#ink-mist)" />
  {/* 近岸：左右两团深色山脚，轻微模糊 */}
  <path
    d="M0 310 C80 285, 160 300, 240 282 C280 275, 300 280, 310 282 L310 420 L0 420 Z"
    fill="var(--text-primary)"
    opacity="0.2"
    filter="url(#ink-blur-near)"
  />
  <path
    d="M890 292 C960 275, 1040 290, 1120 278 C1160 272, 1180 276, 1200 272 L1200 420 L890 420 Z"
    fill="var(--text-primary)"
    opacity="0.2"
    filter="url(#ink-blur-near)"
  />
  {/* 湖面 */}
  <rect x="0" y="285" width="1200" height="35" fill="var(--text-primary)" opacity="0.05" />
  {/* 湖面倒影：横向淡痕 */}
  <ellipse cx="450" cy="296" rx="90" ry="4" fill="var(--text-primary)" opacity="0.06" />
  <ellipse cx="720" cy="301" rx="120" ry="5" fill="var(--text-primary)" opacity="0.06" />
  <ellipse cx="960" cy="293" rx="80" ry="4" fill="var(--text-primary)" opacity="0.06" />
  {/* 水榭（左岸小亭） */}
  <g stroke="var(--text-primary)" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.55">
    <path d="M312 262 L330 250 L348 262" />
    <path d="M318 262 L318 272 M330 260 L330 272 M342 262 L342 272" />
  </g>
  {/* 湖心小船：船身 + 舱亭 + 倒影 */}
  <g fill="var(--text-primary)" opacity="0.75">
    <path d="M570 268 Q600 278 630 268 L626 262 L574 262 Z" />
    <rect x="588" y="250" width="24" height="12" />
    <path d="M584 251 Q600 238 616 251 Z" />
  </g>
  <path d="M576 282 Q600 290 624 282" stroke="var(--text-primary)" stroke-width="2" fill="none" opacity="0.12" />
  {/* 飞鸟 */}
  <path
    d="M400 158 q7 -7 14 0 q7 -7 14 0"
    stroke="var(--text-primary)"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    opacity="0.5"
  />
  <path
    d="M780 148 q6 -6 12 0 q6 -6 12 0"
    stroke="var(--text-primary)"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    opacity="0.4"
  />
</svg>
