---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroParticles from '../components/HeroParticles.astro';
import { readingLabel } from '../lib/reading-time';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, BookOpen, Calendar, Clock } from '@lucide/astro';

// Fetch recent posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const yearsWriting = new Date().getFullYear() - 2020;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<Layout>
  <div>
    <!-- Hero -->
    <section class="relative overflow-hidden pt-6 pb-10 sm:pt-10 sm:pb-14">
      <HeroParticles />
      <span id="hero-watermark" aria-hidden="true" class="hero-watermark pointer-events-none select-none absolute -right-2 -top-8 hidden font-serif-heading text-[11rem] font-bold leading-none sm:block">ZUO</span>
      <p class="reveal font-mono-code text-xs tracking-[0.2em] uppercase text-[var(--accent)]">
        你好，我是 ZUO · 全栈工程师
      </p>
      <h1 class="reveal mt-4 font-serif-heading text-4xl font-bold leading-[1.15] tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-[3.4rem]" style="transition-delay:60ms">
        写代码，<br />也写思考。
      </h1>
      <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg" style="transition-delay:120ms">
        专注分布式系统、现代 Web 与国际化工程。这里是我的技术主页与思考沉淀：手记、作品与实验，都在这里。
      </p>
      <div class="reveal mt-7 flex flex-wrap items-center gap-3" style="transition-delay:180ms">
        <a
          href={`${base}projects`}
          class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[var(--accent-hover)] hover:shadow-md active:translate-y-0 active:scale-[0.98]"
        >
          看看我的作品
          <ArrowUpRight class="w-4 h-4" />
        </a>
        <a
          href={`${base}blog`}
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)] px-6 py-3 text-sm font-medium text-[var(--text-primary)] transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)] hover:shadow-md active:translate-y-0 active:scale-[0.98]"
        >
          读最新文章
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
      <dl class="reveal mt-10 flex flex-wrap gap-x-10 gap-y-4 border-t border-[var(--border-color)] pt-6" style="transition-delay:240ms">
        <div>
          <dt class="sr-only">文章数</dt>
          <dd class="font-serif-heading text-2xl font-bold text-[var(--text-primary)]">
            <span data-count={allPosts.length}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">篇手记</span>
          </dd>
        </div>
        <div>
          <dt class="sr-only">作品数</dt>
          <dd class="font-serif-heading text-2xl font-bold text-[var(--text-primary)]">
            <span data-count={allProjects.length}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">个作品</span>
          </dd>
        </div>
        <div>
          <dt class="sr-only">持续写作</dt>
          <dd class="font-serif-heading text-2xl font-bold text-[var(--text-primary)]">
            <span data-count={yearsWriting}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">年持续写作</span>
          </dd>
        </div>
      </dl>
    </section>

    <!-- Tech Marquee -->
    <div class="marquee -mx-4 overflow-hidden border-y border-[var(--border-color)] py-3 sm:-mx-6" aria-hidden="true">
      <div class="marquee-track flex w-max items-center">
        {[...['TypeScript', 'Go', 'Rust', 'Astro', 'React', 'Vue', 'Tailwind CSS', 'Node.js', 'PostgreSQL', 'Redis', 'Kafka', 'Docker', 'Kubernetes', 'GitHub Actions', 'i18n', 'Obsidian'], ...['TypeScript', 'Go', 'Rust', 'Astro', 'React', 'Vue', 'Tailwind CSS', 'Node.js', 'PostgreSQL', 'Redis', 'Kafka', 'Docker', 'Kubernetes', 'GitHub Actions', 'i18n', 'Obsidian']].map((k) => (
          <span class="flex items-center">
            <span class="px-4 font-mono-code text-xs tracking-wide whitespace-nowrap text-[var(--text-muted)]">{k}</span>
            <span class="text-[var(--accent)] text-[10px]">✦</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Featured Works -->
    {featuredProjects.length > 0 && (
      <section class="reveal pb-4">
        <div class="mb-6 flex items-baseline justify-between border-b border-[var(--border-color)] pb-4">
          <h2 class="font-serif-heading text-xl font-bold tracking-tight text-[var(--text-primary)] sm:text-2xl">
            精选作品
          </h2>
          <a
            href={`${base}projects`}
            class="inline-flex items-center gap-1 text-xs font-medium text-[var(--accent)] hover:underline"
          >
            <span>全部作品</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {featuredProjects.map((project) => (
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              description={project.data.description}
              type={project.data.type}
              techStack={project.data.techStack}
              github={project.data.github}
              demo={project.data.demo}
              download={project.data.download}
              featured={project.data.featured}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Recent Blog Posts Section -->
    <section class="pt-10">
      <div class="mb-8 flex items-baseline justify-between border-b border-[var(--border-color)] pb-4">
        <div class="flex items-center gap-2">
          <BookOpen class="w-5 h-5 text-[var(--accent)]" />
          <h2 class="font-serif-heading text-xl font-bold tracking-tight text-[var(--text-primary)] sm:text-2xl">
            最新手记与思考
          </h2>
        </div>
        <a
          href={`${base}blog`}
          class="group inline-flex items-center gap-1 text-xs font-medium text-[var(--accent)] hover:underline"
        >
          <span>查看全部目录 ({allPosts.length})</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>

      <div class="divide-y divide-[var(--border-color)]">
        {recentPosts.map((post, i) => (
          <article
            class="reveal group -mx-4 rounded-xl px-4 py-6 transition-colors first:pt-0 hover:bg-[var(--bg-surface)]"
            style={`transition-delay:${Math.min(i, 5) * 60}ms`}
          >
            <div class="mb-2 flex items-center gap-3 font-mono-code text-xs text-[var(--text-muted)]">
              <span class="rounded bg-[var(--accent-soft)] px-2 py-0.5 font-serif-heading font-medium text-[var(--accent)]">
                {post.data.category}
              </span>
              <span>·</span>
              <time datetime={post.data.pubDate.toISOString()} class="flex items-center gap-1">
                <Calendar class="w-3.5 h-3.5" />
                {formatDate(post.data.pubDate)}
              </time>
              <span>·</span>
              <span class="flex items-center gap-1">
                <Clock class="w-3.5 h-3.5" />
                {readingLabel(post.body)}
              </span>
            </div>

            <h3 class="font-serif-heading text-lg font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
              <a href={`${base}blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>

            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-8 border-t border-[var(--border-color)] pt-8 text-center">
        <a
          href={`${base}blog`}
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] px-6 py-2.5 text-sm font-medium text-[var(--text-primary)] shadow-xs transition-colors hover:border-[var(--accent)] hover:bg-[var(--bg-surface-soft)] hover:text-[var(--accent)]"
        >
          <span>浏览全部 {allPosts.length} 篇文章</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </section>
  </div>
</Layout>
