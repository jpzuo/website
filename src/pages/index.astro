---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InkHero from '../components/InkHero.astro';
import InkTrail from '../components/InkTrail.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

// Fetch recent posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const yearsWriting = new Date().getFullYear() - 2020;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<Layout>
  <div>
    <!-- Hero: 山水做满首屏背景，文案压在雾上 -->
    <section class="bleed relative flex min-h-[calc(100svh-4rem)] flex-col justify-center">
      {/* 满幅山水背景 */}
      <div class="absolute inset-0" aria-hidden="true">
        <InkHero class="h-full w-full" />
      </div>
      {/* 雾动：三层雾在山水上极缓慢地漂移，画是活的 */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-[5] overflow-hidden">
        <span class="mist mist-a"></span>
        <span class="mist mist-b"></span>
        <span class="mist mist-c"></span>
      </div>
      {/* 顶部淡纱，保证文案可读 */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-2/3 bg-gradient-to-b from-[var(--bg-page)]/80 via-[var(--bg-page)]/25 to-transparent"></div>

      <div class="relative z-10 mx-auto w-full max-w-3xl px-6 py-20 sm:py-24">
        <h1 class="reveal font-mono-code text-xs tracking-[0.2em] uppercase text-[var(--accent)]">
          你好，我是 ZUO，一名软件开发工程师
        </h1>
        <blockquote class="reveal mt-8 max-w-xl" style="transition-delay:60ms">
          <p class="font-serif-heading text-xl font-bold leading-relaxed text-[var(--text-primary)] sm:text-2xl">
            “纸上得来终觉浅，绝知此事要躬行。”
          </p>
          <cite class="mt-3 block font-mono-code text-xs tracking-wider text-[var(--text-muted)] not-italic">
            —— 陆游《冬夜读书示子聿》
          </cite>
        </blockquote>
        <div class="reveal mt-8 flex flex-wrap items-center gap-6" style="transition-delay:180ms">
          <a
            href={`${base}projects`}
            class="inline-flex items-center gap-2 rounded-md bg-[var(--text-primary)] px-6 py-3 text-sm font-medium text-[var(--bg-page)] shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:opacity-90 hover:shadow-md active:translate-y-0 active:scale-[0.98]"
          >
            看看我的作品
            <ArrowUpRight class="w-4 h-4" />
          </a>
          <a
            href={`${base}blog`}
            class="group inline-flex items-center gap-1.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]"
          >
            读最新文章
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>

        {/* 数字：一行素面统计 */}
        <dl class="reveal mt-12 flex flex-wrap gap-x-12 gap-y-4" style="transition-delay:240ms">
          <div>
            <dt class="sr-only">文章数</dt>
            <dd class="font-serif-heading text-3xl font-bold text-[var(--text-primary)]">
              <span data-count={allPosts.length}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">篇手记</span>
            </dd>
          </div>
          <div>
            <dt class="sr-only">作品数</dt>
            <dd class="font-serif-heading text-3xl font-bold text-[var(--text-primary)]">
              <span data-count={allProjects.length}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">个作品</span>
            </dd>
          </div>
          <div>
            <dt class="sr-only">持续写作</dt>
            <dd class="font-serif-heading text-3xl font-bold text-[var(--text-primary)]">
              <span data-count={yearsWriting}>0</span><span class="ml-1 text-sm font-medium text-[var(--text-muted)]">年持续写作</span>
            </dd>
          </div>
        </dl>
      </div>

      {/* 印章 + 竖排题字，落在首屏右下角、湖面之上 */}
      <div aria-hidden="true" class="pointer-events-none absolute bottom-8 right-6 z-10 hidden select-none flex-col items-center gap-4 sm:flex">
        <span class="seal h-10 w-10 text-lg">左</span>
        <span class="vertical-text font-serif-heading text-sm text-[var(--text-muted)]">闲来落笔</span>
      </div>
    </section>

    <!-- Featured Works: 单栏大条目 -->
    {featuredProjects.length > 0 && (
      <section class="reveal pt-20 sm:pt-24">
        <p class="font-mono-code text-xs tracking-[0.2em] uppercase text-[var(--accent)]">作品 · Works</p>
        <h2 class="mt-3 font-serif-heading text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl">
          精选作品
        </h2>
        <span aria-hidden="true" class="brush-line mt-5"></span>
        <div class="mt-4">
          {featuredProjects.map((project) => (
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              description={project.data.description}
              type={project.data.type}
              techStack={project.data.techStack}
              github={project.data.github}
              demo={project.data.demo}
              download={project.data.download}
              featured={project.data.featured}
            />
          ))}
        </div>
        <a
          href={`${base}projects`}
          class="group mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:underline"
        >
          <span>全部作品</span>
          <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </section>
    )}

    <!-- Recent Blog Posts: 素面标题列 -->
    <section class="pt-20 sm:pt-24">
      <p class="font-mono-code text-xs tracking-[0.2em] uppercase text-[var(--accent)]">手记 · Notes</p>
      <h2 class="mt-3 font-serif-heading text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl">
        最新手记与思考
      </h2>
      <span aria-hidden="true" class="brush-line mt-5"></span>
      <ul class="mt-4 divide-y divide-[var(--border-color)]/60">
        {recentPosts.map((post, i) => (
          <li class="reveal group py-5 first:pt-2" style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
            <a href={`${base}blog/${post.id}`} class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-5">
              <time datetime={post.data.pubDate.toISOString()} class="shrink-0 font-mono-code text-xs text-[var(--text-muted)]">
                {formatDate(post.data.pubDate)}
              </time>
              <span class="font-serif-heading text-lg font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
                {post.data.title}
              </span>
              <span class="shrink-0 text-xs text-[var(--accent)] sm:ml-auto">
                {post.data.category}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href={`${base}blog`}
        class="group mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:underline"
      >
        <span>浏览全部 {allPosts.length} 篇文章</span>
        <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
    </section>
  </div>

  {/* 落墨：鼠标划过留淡墨痕 */}
  <InkTrail />

  <style>
    .mist {
      position: absolute;
      display: block;
      border-radius: 9999px;
      background: radial-gradient(ellipse at center, var(--bg-page) 0%, var(--bg-page) 35%, transparent 70%);
      opacity: 0.55;
      filter: blur(24px);
      animation: mist-drift 80s ease-in-out infinite alternate;
      will-change: transform;
    }
    .mist-a { top: 16%; left: -10%; width: 70vw; height: 180px; }
    .mist-b { top: 46%; left: 20%; width: 80vw; height: 220px; animation-duration: 115s; animation-delay: -30s; opacity: 0.45; }
    .mist-c { top: 68%; left: -5%; width: 60vw; height: 160px; animation-duration: 95s; animation-delay: -60s; opacity: 0.5; }
    @keyframes mist-drift {
      from { transform: translateX(-6vw); }
      to { transform: translateX(6vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      .mist { animation: none; }
    }
  </style>

  {/* 数字滚动：原先在 HeroParticles 里，星图去掉后单独保留在这里 */}
  <script is:inline>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function animate(el) {
        var target = parseInt(el.getAttribute('data-count') || '0', 10);
        if (reduceMotion) {
          el.textContent = String(target);
          return;
        }
        var start = null, dur = 1100;
        function step(ts) {
          if (!start) start = ts;
          var t = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      function boot() {
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
        if (!els.length) return;
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                animate(entry.target);
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.4 });
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(animate);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    })();
  </script>
</Layout>
