---
import Layout from '../../layouts/Layout.astro';
import { readingLabel } from '../../lib/reading-time';
import { getCollection } from 'astro:content';
import { Calendar, Archive } from '@lucide/astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group by year, newest first
const yearMap = new Map<number, typeof posts>();
posts.forEach((p) => {
  const year = p.data.pubDate.getFullYear();
  const list = yearMap.get(year) ?? [];
  list.push(p);
  yearMap.set(year, list);
});
const years = Array.from(yearMap.entries()).sort((a, b) => b[0] - a[0]);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<Layout title="归档 · 按年浏览 · ZUO" description="全部文章按年份归档浏览。">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-serif-heading font-medium text-[var(--accent)] bg-[var(--accent-soft)] px-2.5 py-1 rounded-full mb-4">
      <Archive class="w-3.5 h-3.5" />
      <span>归档 · Archive</span>
    </div>
    <h1 class="font-serif-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
      按年归档
    </h1>
    <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
      共 {posts.length} 篇手记，从 {years[years.length - 1]?.[0]} 年写到现在。
    </p>
    <div class="mt-6 flex items-center gap-4">
      <span aria-hidden="true" class="brush-line"></span>
      <span aria-hidden="true" class="seal h-8 w-8 text-sm">档</span>
    </div>
  </div>

  <div class="space-y-12">
    {years.map(([year, yearPosts]) => (
      <section>
        <div class="flex items-baseline gap-3">
          <h2 class="font-serif-heading text-2xl font-bold text-[var(--text-primary)]">{year}</h2>
          <span class="text-xs text-[var(--text-muted)] font-mono-code">{yearPosts.length} 篇</span>
        </div>
        <span aria-hidden="true" class="brush-line mt-3 mb-4"></span>
        <ul class="divide-y divide-[var(--border-color)]">
          {yearPosts.map((post) => (
            <li class="group py-4 first:pt-5">
              <a href={`${base}blog/${post.id}`} class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <span class="shrink-0 text-xs text-[var(--text-muted)] font-mono-code flex items-center gap-1">
                  <Calendar class="w-3 h-3" />
                  {formatDate(post.data.pubDate)}
                </span>
                <span class="font-serif-heading font-bold text-base text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                  {post.data.title}
                </span>
                <span class="sm:ml-auto shrink-0 flex items-center gap-2 text-xs text-[var(--text-muted)]">
                  <span class="text-[var(--accent)] bg-[var(--accent-soft)] px-2 py-0.5 rounded">{post.data.category}</span>
                  <span class="font-mono-code">{readingLabel(post.body)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="mt-12 pt-8 border-t border-[var(--border-color)]">
    <a href={`${base}blog`} class="text-sm font-medium text-[var(--accent)] hover:underline">
      ← 回到文章列表
    </a>
  </div>
</Layout>
