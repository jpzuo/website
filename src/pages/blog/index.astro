---
import Layout from '../../layouts/Layout.astro';
import InkLandscape from '../../components/InkLandscape.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by pubDate descending
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect categories with count
const categoryMap = new Map<string, number>();
posts.forEach((p) => {
  const cat = p.data.category || '未分类';
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});
const categories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]);

// Collect unique tags with count
const tagMap = new Map<string, number>();
posts.forEach((p) => {
  p.data.tags.forEach((t) => {
    if (t) tagMap.set(t, (tagMap.get(t) || 0) + 1);
  });
});
const allTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
};
---

<Layout
  title="文章与思考手记 · ZUO"
  description="记录全栈架构、系统设计、数字美学与知识管理领域的工程实践与思考手记。"
>
  <!-- Page header: 标题 + 印 + 竖排题字 -->
  <div class="mb-10 flex items-start justify-between gap-6">
    <div>
      <h1 class="font-serif-heading text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-5xl">
        手记
      </h1>
      <p class="mt-4 max-w-xl text-base text-[var(--text-secondary)] leading-relaxed">
        共 {posts.length} 篇技术手记，按分类、标签与关键词检索。
      </p>
      <span aria-hidden="true" class="brush-line mt-6"></span>
    </div>
    <div aria-hidden="true" class="hidden select-none flex-col items-center gap-3 pt-1 sm:flex">
      <span class="seal h-10 w-10 text-lg">记</span>
      <span class="vertical-text font-serif-heading text-sm text-[var(--text-muted)]">落笔有痕</span>
    </div>
  </div>

  {/* 通幅山水 */}
  <div class="bleed relative -mt-2 mb-12">
    <InkLandscape class="h-48 sm:h-56" />
  </div>

  <!-- Search: 一行素面检索 -->
  <div class="relative mb-8">
    <label for="search-input" class="sr-only">搜索文章</label>
    <input
      id="search-input"
      type="search"
      placeholder="搜索标题、分类、标签…"
      autocomplete="off"
      class="w-full border-b border-[var(--border-color)] bg-transparent py-2.5 pr-8 text-base text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none focus:border-[var(--accent)]"
    />
    <button
      id="search-clear"
      type="button"
      aria-label="清空搜索"
      class="hidden absolute right-1 top-1/2 -translate-y-1/2 w-6 h-6 text-[var(--text-muted)] hover:text-[var(--text-primary)] items-center justify-center text-base leading-none cursor-pointer"
    >
      ×
    </button>
  </div>

  <!-- Category filter: 素面文字链接 -->
  <nav class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2" id="category-filter-group">
    <button
      data-filter-type="all"
      data-filter-val="all"
      class="filter-pill cursor-pointer text-sm font-semibold text-[var(--accent)] underline underline-offset-4 transition-colors"
    >
      全部文章 <span class="font-mono-code text-xs opacity-70">({posts.length})</span>
    </button>
    {categories.map(([cat, count]) => (
      <button
        data-filter-type="category"
        data-filter-val={cat}
        class="filter-pill cursor-pointer text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        {cat} <span class="font-mono-code text-xs opacity-60">({count})</span>
      </button>
    ))}
    <span class="ml-auto text-[11px] text-[var(--text-muted)] font-mono-code" id="filter-count">
      共 {posts.length} 篇
    </span>
  </nav>

  <!-- Tag filter: 素面小字 -->
  {allTags.length > 0 && (
    <div class="mb-10 flex flex-wrap gap-x-4 gap-y-2" id="tag-filter-group">
      {allTags.map(([tag, count]) => (
        <button
          data-filter-type="tag"
          data-filter-val={tag}
          class="filter-tag cursor-pointer font-mono-code text-xs text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
        >
          #{tag} <span class="opacity-60">({count})</span>
        </button>
      ))}
    </div>
  )}

  <!-- Articles: 素面标题列 -->
  <ul class="divide-y divide-[var(--border-color)]/60" id="posts-container">
    {posts.map((post, i) => (
      <li
        class="reveal post-item py-5 first:pt-1 group"
        style={`transition-delay:${Math.min(i, 6) * 50}ms`}
        data-category={post.data.category}
        data-tags={JSON.stringify(post.data.tags)}
        data-search={`${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
      >
        <a href={`${base}blog/${post.id}`} class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-5">
          <time datetime={post.data.pubDate.toISOString()} class="shrink-0 font-mono-code text-xs text-[var(--text-muted)]">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="font-serif-heading text-lg font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
            {post.data.title}
          </span>
          <span class="shrink-0 text-xs text-[var(--accent)] sm:ml-auto">
            {post.data.category}
          </span>
        </a>
      </li>
    ))}

    <!-- Empty state -->
    <li id="empty-state" class="hidden py-16 text-center text-sm text-[var(--text-muted)]">
      没有找到匹配的文章，换个关键词或筛选条件试试。
    </li>
  </ul>

  <!-- Archive link -->
  <div class="mt-10">
    <span aria-hidden="true" class="brush-line mb-6"></span>
    <a
      href={`${base}blog/archive`}
      class="group inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)] hover:underline"
    >
      <span>按年归档</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>

  <!-- Interactive Filter + Search Script -->
  <script is:inline>
    const categoryBtns = document.querySelectorAll('.filter-pill');
    const tagBtns = document.querySelectorAll('.filter-tag');
    const postItems = document.querySelectorAll('.post-item');
    const emptyState = document.getElementById('empty-state');
    const countDisplay = document.getElementById('filter-count');
    const searchInput = document.getElementById('search-input');
    const searchClear = document.getElementById('search-clear');

    let currentFilterType = 'all';
    let currentFilterVal = 'all';
    let currentSearch = '';

    function resetButtons() {
      categoryBtns.forEach((btn) => {
        btn.classList.remove('text-[var(--accent)]', 'font-semibold', 'underline', 'underline-offset-4');
        btn.classList.add('text-[var(--text-secondary)]');
      });
      tagBtns.forEach((btn) => {
        btn.classList.remove('text-[var(--accent)]', 'font-semibold', 'underline', 'underline-offset-4');
        btn.classList.add('text-[var(--text-muted)]');
      });
    }

    function applyFilter() {
      let visible = 0;
      const q = currentSearch.trim().toLowerCase();
      postItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
        const haystack = item.getAttribute('data-search') || '';

        let match = false;
        if (currentFilterType === 'all') {
          match = true;
        } else if (currentFilterType === 'category') {
          match = itemCat === currentFilterVal;
        } else if (currentFilterType === 'tag') {
          match = itemTags.includes(currentFilterVal);
        }

        if (match && q) {
          match = haystack.includes(q);
        }

        if (match) {
          item.classList.remove('hidden');
          visible++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `找到 ${visible} 篇`;
      }
      if (emptyState) {
        if (visible === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }
      if (searchClear) {
        const show = currentSearch.trim().length > 0;
        searchClear.classList.toggle('hidden', !show);
        searchClear.classList.toggle('flex', show);
      }
    }

    searchInput?.addEventListener('input', () => {
      currentSearch = searchInput.value || '';
      applyFilter();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      applyFilter();
      searchInput?.focus();
    });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        resetButtons();
        btn.classList.add('text-[var(--accent)]', 'font-semibold', 'underline', 'underline-offset-4');
        btn.classList.remove('text-[var(--text-secondary)]');

        currentFilterType = btn.getAttribute('data-filter-type') || 'all';
        currentFilterVal = btn.getAttribute('data-filter-val') || 'all';
        applyFilter();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        resetButtons();
        btn.classList.add('text-[var(--accent)]', 'font-semibold', 'underline', 'underline-offset-4');
        btn.classList.remove('text-[var(--text-muted)]');

        currentFilterType = 'tag';
        currentFilterVal = btn.getAttribute('data-filter-val') || '';
        applyFilter();
      });
    });
  </script>
</Layout>
