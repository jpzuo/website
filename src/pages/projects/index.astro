---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Layers, Building, CodeXml, Sparkles } from '@lucide/astro';

const allProjects = await getCollection('projects');
// Sort by order asc
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="作品集与工程实践 · ZUO"
  description="展示全栈系统、开源工具与实验性交互作品。"
>
  <div class="space-y-10">
    <!-- Header banner -->
    <header class="pb-8">
      <div class="inline-flex items-center gap-2 text-xs font-serif-heading font-medium text-[var(--accent)] bg-[var(--accent-soft)] px-2.5 py-1 rounded-full mb-3">
        <Layers class="w-3.5 h-3.5" />
        <span>工程与作品 · Portfolio</span>
      </div>
      <h1 class="font-serif-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
        工程实践、开源工具与数字试验
      </h1>
      <p class="mt-3 text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        将理论付诸代码，从承载业务的高可用企业级系统，到提升开发体验的开源小工具，以及纯粹出于好奇心探索的实验性交互项目。
      </p>
      <div class="mt-6 flex items-center gap-4">
        <span aria-hidden="true" class="brush-line"></span>
        <span aria-hidden="true" class="seal h-8 w-8 text-sm">集</span>
      </div>
    </header>

    <!-- Project Type Filter Buttons -->
    <div class="flex flex-wrap items-center gap-2 pb-2 text-xs font-mono-code" id="project-filter-bar">
      <button
        data-filter="all"
        class="project-filter-btn px-3.5 py-1.5 rounded-md border border-[var(--accent)] bg-[var(--accent)] text-white font-medium cursor-pointer transition-colors duration-150 inline-flex items-center gap-1.5 whitespace-nowrap shrink-0 shadow-xs"
      >
        <span>全部作品</span>
        <span class="opacity-75">({projects.length})</span>
      </button>
      <button
        data-filter="commercial"
        class="project-filter-btn px-3.5 py-1.5 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors duration-150 inline-flex items-center gap-1.5 whitespace-nowrap shrink-0"
      >
        <Building class="w-3.5 h-3.5 text-[var(--text-muted)]" />
        <span>上线 / 商业产品</span>
      </button>
      <button
        data-filter="opensource"
        class="project-filter-btn px-3.5 py-1.5 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors duration-150 inline-flex items-center gap-1.5 whitespace-nowrap shrink-0"
      >
        <CodeXml class="w-3.5 h-3.5 text-[var(--text-muted)]" />
        <span>开源工具</span>
      </button>
      <button
        data-filter="experiment"
        class="project-filter-btn px-3.5 py-1.5 rounded-md border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors duration-150 inline-flex items-center gap-1.5 whitespace-nowrap shrink-0"
      >
        <Sparkles class="w-3.5 h-3.5 text-[var(--accent)]" />
        <span>实验探索</span>
      </button>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {projects.map((project, i) => (
        <div class="reveal project-wrapper" data-type={project.data.type} style={`transition-delay:${Math.min(i, 5) * 80}ms`}>
          <ProjectCard
            slug={project.id}
            title={project.data.title}
            description={project.data.description}
            type={project.data.type}
            techStack={project.data.techStack}
            github={project.data.github}
            demo={project.data.demo}
            download={project.data.download}
            featured={project.data.featured}
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Filter script -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.project-filter-btn');
    const projectCards = document.querySelectorAll('.project-wrapper');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterType = btn.getAttribute('data-filter');

        // Update active button state
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]');
          b.classList.add('bg-[var(--bg-surface)]', 'text-[var(--text-secondary)]', 'border-[var(--border-color)]');
        });
        btn.classList.add('bg-[var(--accent)]', 'text-white', 'border-[var(--accent)]');
        btn.classList.remove('bg-[var(--bg-surface)]', 'text-[var(--text-secondary)]', 'border-[var(--border-color)]');

        // Show/hide project cards
        projectCards.forEach((card) => {
          const cardType = card.getAttribute('data-type');
          if (filterType === 'all' || cardType === filterType) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
