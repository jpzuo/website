---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Download } from '@lucide/astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const downloadUrl = project.data.download ? `${base}${project.data.download.replace(/^\//, '')}` : undefined;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} · 作品`} description={project.data.description}>
  <div class="space-y-8">
    <a
      href={`${base}projects`}
      class="inline-flex items-center gap-1.5 text-sm text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors group"
    >
      <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
      <span>返回作品</span>
    </a>

    <header class="pb-8">
      <h1 class="font-serif-heading text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
        {project.data.title}
      </h1>
      <p class="mt-3 text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        {project.data.description}
      </p>
      <div class="flex flex-wrap gap-1.5 mt-5">
        {project.data.techStack.map((tech) => (
          <span class="px-2 py-0.5 text-xs font-mono-code rounded bg-[var(--bg-surface-soft)] text-[var(--text-muted)] border border-[var(--border-color)]/50">
            {tech}
          </span>
        ))}
      </div>
      <div class="mt-6 flex items-center gap-4">
        <span aria-hidden="true" class="brush-line"></span>
        <span aria-hidden="true" class="seal h-8 w-8 text-sm">作</span>
      </div>
    </header>

    {project.data.download && (
      <div class="p-5 rounded-md ink-frame bg-[var(--bg-surface)] flex flex-col sm:flex-row sm:items-center gap-4">
        <a
          href={downloadUrl}
          download
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity shrink-0"
        >
          <Download class="w-4 h-4" />
          <span>下载完整作品包 (.zip)</span>
        </a>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          一键下载完整 Skill 包：21KB，14 个文件，含 SKILL.md、本地扫描脚本、Key 命名规则、自查清单、导入模板与演示工程。
        </p>
      </div>
    )}

    <div class="ink-dropcap prose dark:prose-invert prose-stone max-w-none prose-headings:font-serif-heading prose-headings:font-bold prose-headings:tracking-tight prose-a:text-[var(--accent)] prose-a:underline hover:prose-a:text-[var(--accent-hover)] prose-blockquote:border-l-[var(--accent)] prose-blockquote:font-serif-heading prose-blockquote:italic prose-pre:my-6 prose-pre:rounded-xl leading-relaxed">
      <Content />
    </div>

    <div class="pt-6 border-t border-[var(--border-color)]">
      <a href={`${base}projects`} class="text-sm text-[var(--accent)] hover:underline font-medium">
        ← 返回作品
      </a>
    </div>
  </div>
</Layout>
